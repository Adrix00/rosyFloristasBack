<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!--
    Constructor Injection is mandatory (CLAUDE.md): every Service, Persistence Adapter and JDBC
    Repository stores its injected ports/templates in a final field. SpotBugs' Low threshold
    treats that as EI_EXPOSE_REP2 regardless of the field being a stateless Spring-managed
    singleton (an interface, a JdbcTemplate...). Real mutable-state leaks in DTOs/domain records
    stay caught; this only covers the DI-holds-a-collaborator pattern.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2" />
    <Or>
      <Package name="~.*\.application\..*\.service" />
      <Package name="~.*\.application\..*\.validation" />
      <Package name="~.*\.infrastructure\.persistence\.adapter\..*" />
      <Package name="~.*\.infrastructure\.persistence\.jdbc\..*\.repository" />
    </Or>
  </Match>

  <!-- Spring Security's HttpSecurity#build() and our own constraint-translation fallback are
       framework/defensive idioms, not real bugs. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
  </Match>
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
  </Match>

  <!--
    JPA bidirectional associations must expose the managed parent/child entity reference so
    Hibernate can own the FK and cascade persists. Defensively copying these entities would break
    object identity, cascade semantics and orphanRemoval; the getters/setters are not DTOs leaking
    value objects. Collections and maps still copy/unmodifiable in the entities themselves.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Or>
      <And>
        <Class name="com.floristeriarosy.infrastructure.persistence.entity.order.OrderEntity" />
        <Or>
          <Method name="getDelivery" />
          <Method name="setDelivery" />
        </Or>
      </And>
      <And>
        <Class name="com.floristeriarosy.infrastructure.persistence.entity.order.OrderItemEntity" />
        <Or>
          <Method name="getOrder" />
          <Method name="setOrder" />
          <Method name="&lt;init&gt;" />
        </Or>
      </And>
      <And>
        <Class name="com.floristeriarosy.infrastructure.persistence.entity.order.OrderDeliveryEntity" />
        <Or>
          <Method name="getOrder" />
          <Method name="setOrder" />
          <Method name="&lt;init&gt;" />
        </Or>
      </And>
    </Or>
  </Match>
</FindBugsFilter>
